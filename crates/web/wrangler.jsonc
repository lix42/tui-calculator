// Cloudflare Workers Static Assets: no `main` script, so Cloudflare serves
// dist/ as-is. Deployed by the `cloudflare` job in
// .github/workflows/deploy-web.yml, from the same build GitHub Pages gets.
// Keep `assets.directory` on dist/: anything that contains target/ would pull
// in debug .wasm files over the 25 MiB per-file limit.
{
  "name": "tui-calculator",
  "compatibility_date": "2026-10-08",
  "assets": { "directory": "./dist" },
  // Off on purpose: the Custom Domains below replace it. Spelled out because
  // wrangler warns on every deploy when it's left implicit.
  "workers_dev": false,
  // Custom Domains: Cloudflare creates the DNS record and certificate for each
  // on deploy. Adding or removing one needs the CI token to have
  // Zone > Workers Routes > Write on that zone; deploys that leave them alone
  // don't.
  "routes": [
    { "pattern": "calc.xuli.dev", "custom_domain": true },
    { "pattern": "calc.lix42.com", "custom_domain": true }
  ]
}
